pkgbase = hyprland-tts
	pkgdesc = Accessible, multilingual, offline Text-to-Speech for Hyprland (Qwen3-TTS neural voices, Piper fallback) with smart playback controls and a voice manager
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/artibex/hyprland-tts
	arch = any
	license = Apache-2.0
	license = CC-BY-4.0
	license = CC0-1.0
	makedepends = make
	depends = bash
	depends = python
	depends = piper-tts-bin
	depends = wl-clipboard
	depends = mpv
	depends = socat
	depends = procps-ng
	depends = curl
	depends = gawk
	depends = sed
	depends = grep
	depends = util-linux
	depends = findutils
	depends = gtk4
	depends = libadwaita
	depends = python-gobject
	optdepends = hyprland: target compositor for keybinds and the hover command
	optdepends = tesseract: read text inside copied images (OCR)
	optdepends = tesseract-data-eng: English OCR language data
	optdepends = perl-image-exiftool: read embedded image description metadata
	optdepends = at-spi2-core: speak text under the mouse cursor (hyprland-tts hover)
	optdepends = libnotify: desktop notifications when a keybind-triggered action fails silently
	optdepends = python-fasttext-predict: language detection without a private venv (AUR; else: hyprland-tts deps install)
	optdepends = python-num2words: number and date reading without a private venv (AUR; else: hyprland-tts deps install)
	optdepends = vulkan-icd-loader: Vulkan loader, needed to run the Qwen3 engine on the GPU
	optdepends = cmake: build the Qwen3 neural engine (hyprland-tts engine install qwen3)
	optdepends = git: fetch the pinned Qwen3 engine sources (hyprland-tts engine install qwen3)
	optdepends = gcc: compile the Qwen3 neural engine (hyprland-tts engine install qwen3)
	optdepends = make: build tool for the Qwen3 neural engine (hyprland-tts engine install qwen3)
	optdepends = shaderc: glslc shader compiler for the GPU (Vulkan) build of the Qwen3 engine
	optdepends = vulkan-headers: Vulkan headers for the GPU build (pinned ones are fetched if absent)
	optdepends = spirv-headers: SPIR-V headers for the GPU build (pinned ones are fetched if absent)

pkgname = hyprland-tts
