[Desktop Entry]
Type=Application
Name=hyprland-tts
GenericName=Text-to-Speech Manager
Comment=Manage the speech engine, voices, language detection and shortcuts of hyprland-tts
# Routed through the CLI dispatcher (not the raw hyprland-tts-gui binary) so an
# app-launcher's environment gets the same PATH-shadowing-safe python3
# resolution as a terminal launch — see bin/hyprland-tts::_gui_python.
Exec=hyprland-tts gui
Icon=audio-speakers
Terminal=false
Categories=Utility;Accessibility;AudioVideo;
Keywords=tts;speech;voice;accessibility;piper;qwen;neural;
StartupNotify=true
