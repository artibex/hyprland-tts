def _refuse_root_user():
    """Exit when running as root, because root cannot reach the user's desktop session.

    As root the Wayland session is unreachable ("Authorization required") and ~/.config would
    resolve below /root. bin/hyprland-tts blocks this too; this is defense in depth for
    anyone starting the GUI script directly.

    Args:
        None.

    Returns:
        None; terminates the process with status 1 for root unless the CI escape hatch is set.
    """
    # Only POSIX systems have geteuid; elsewhere there is nothing to refuse.
    is_root = hasattr(os, "geteuid") and os.geteuid() == 0
    # The documented escape hatch exists for packaging and CI only.
    escape_hatch_set = os.environ.get("HYPRLAND_TTS_ALLOW_ROOT") == "1"
    if is_root and not escape_hatch_set:
        # Explain the real fix instead of letting GTK die with an opaque error.
        sys.stderr.write(
            "hyprland-tts-gui: refusing to run as root/with sudo.\n"
            "It needs your desktop session (Wayland) and your own $HOME — run it as\n"
            "your normal user instead.\n"
        )
        sys.exit(1)


def _gtk_stack_importable():
    """Tell whether the running interpreter can load GTK 4 and libadwaita.

    Args:
        None.

    Returns:
        True when PyGObject, Gtk 4.0 and Adw 1 can be imported; False otherwise.
    """
    try:
        # Importing and pinning the versions is exactly what the real import below does.
        import gi

        gi.require_version("Gtk", "4.0")
        gi.require_version("Adw", "1")
    except (ImportError, ValueError):
        # Missing PyGObject or a missing typelib both mean "not usable here".
        return False
    return True


def _reexec_with_gtk_python():
    """Re-run this script under /usr/bin/python3 when the current interpreter lacks GTK.

    A PATH-shadowing interpreter (pyenv, mise, conda, uv, asdf) has no pacman-installed
    PyGObject. A desktop launcher that invokes this file directly would then fail silently
    because it has no terminal to show the ImportError, so the probe-and-reexec lives here
    as well as in bin/hyprland-tts (_gui_python).

    Args:
        None.

    Returns:
        None; replaces the process when a working system interpreter exists, otherwise returns.
    """
    # A marker stops an endless loop when the system interpreter fails too.
    if os.environ.get("_HYPRLAND_TTS_GUI_REEXECED") == "1":
        return
    # The current interpreter already works, so nothing needs to change.
    if _gtk_stack_importable():
        return
    system_python = "/usr/bin/python3"
    # Re-running the very same failing interpreter would achieve nothing.
    if os.path.realpath(sys.executable) == os.path.realpath(system_python):
        return
    if os.access(system_python, os.X_OK):
        # Set the marker before exec so the child cannot recurse.
        os.environ["_HYPRLAND_TTS_GUI_REEXECED"] = "1"
        # On failure execution simply continues to the normal "install GTK" message below.
        with contextlib.suppress(OSError):
            os.execv(system_python, [system_python, os.path.realpath(__file__), *sys.argv[1:]])


# Root is refused before any GTK or session access happens.
_refuse_root_user()
_reexec_with_gtk_python()

