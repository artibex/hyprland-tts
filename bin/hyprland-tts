#!/usr/bin/env bash
# ==============================================================================
# hyprland-tts — accessible, multilingual, offline Text-to-Speech for Hyprland
# ------------------------------------------------------------------------------
# Single entry point. Subcommands:
#   speak                 Speak the current primary selection (start smart player)
#   ctl <cmd>             Control active playback: next|prev|restart|faster|
#                         slower|pause|resume|toggle|stop|status
#   stop                  Stop any active playback
#   model <sub>           Manage voice models: list|catalog|install|install-url|
#                         remove|default
#   gui                   Launch the graphical model manager
#   setup                 Wire keybinds into Hyprland (per-user, idempotent)
#   uninstall             Remove per-user wiring (keeps downloaded models)
#   purge                 Remove per-user wiring AND downloaded models/state
#   help                  Show this help
#
# This file is the single source of truth for runtime logic. The GUI is a thin
# front end that shells out to `model` subcommands. See Agent.md.
# ==============================================================================
set -euo pipefail

# ------------------------------------------------------------------------------
# XDG-compliant paths (respect overrides; fall back to defaults)
# ------------------------------------------------------------------------------
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
RUNTIME_ROOT="${XDG_RUNTIME_DIR:-/tmp}"

MODELS_DIR="$DATA_HOME/piper-tts"
STATE_DIR="$STATE_HOME/piper-tts"
LAST_MODEL_FILE="$STATE_DIR/last-model"
CONFIG_DIR="$CONFIG_HOME/piper-tts"
CONFIG_FILE="$CONFIG_DIR/config"
RUN_DIR="$RUNTIME_ROOT/hyprland-tts"

HYPR_DIR="$CONFIG_HOME/hypr"
TTS_CONF="$HYPR_DIR/tts.conf"
MAIN_CONF="$HYPR_DIR/hyprland.conf"

# Defaults (overridable via config file)
PIPER_BIN="piper-tts"
DEFAULT_SPEED="1.0"
SPEED_MIN="0.5"
SPEED_MAX="2.0"
SPEED_STEP="0.1"
DEFAULT_RATE="22050"

# ------------------------------------------------------------------------------
# Small helpers
# ------------------------------------------------------------------------------
log()  { printf '%s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

load_config() {
  # Config is a sourced bash fragment holding only simple assignments.
  # It is written by us; still, treat a missing/broken file as "no config".
  [ -f "$CONFIG_FILE" ] || return 0
  # shellcheck disable=SC1090
  source "$CONFIG_FILE" 2>/dev/null || log "warning: could not read $CONFIG_FILE, using defaults"
}

# ------------------------------------------------------------------------------
# Curated voice catalog. Format per line: key|lang|model|base_url|quality|label
# base_url + "/<model>.onnx" and ".onnx.json" are the download targets.
# ------------------------------------------------------------------------------
HF="https://huggingface.co/rhasspy/piper-voices/resolve/main"
catalog_lines() {
  cat <<CATALOG
en-ryan-high|en|en_US-ryan-high|$HF/en/en_US/ryan/high|high|English (US) — Ryan
en-amy-medium|en|en_US-amy-medium|$HF/en/en_US/amy/medium|medium|English (US) — Amy
en-alba-medium|en|en_GB-alba-medium|$HF/en/en_GB/alba/medium|medium|English (GB) — Alba
de-thorsten-high|de|de_DE-thorsten-high|$HF/de/de_DE/thorsten/high|high|German — Thorsten
fr-siwis-medium|fr|fr_FR-siwis-medium|$HF/fr/fr_FR/siwis/medium|medium|French — Siwis
es-carlfm-x_low|es|es_ES-carlfm-x_low|$HF/es/es_ES/carlfm/x_low|x_low|Spanish — Carlfm
it-riccardo-x_low|it|it_IT-riccardo-x_low|$HF/it/it_IT/riccardo/x_low|x_low|Italian — Riccardo
CATALOG
}

# ==============================================================================
# LANGUAGE DETECTION + MODEL RESOLUTION
# ==============================================================================
# Distinctive character classes / stop-words per language. Accent-heavy scripts
# are checked first (strong signal); English stop-words last before fallback.
REGEX_DE='[ÄäÖöÜüß]|(^|[^[:alpha:]])(der|die|das|ist|und|nicht|ich|mit|von|dem|den|ein|eine|auch|aber|sind|wird)([^[:alpha:]]|$)'
REGEX_FR='[ÉéÈèÇçÀàÙùÂâÊêÎîÔôÛûËëÏï]|(^|[^[:alpha:]])(le|la|les|est|une|des|que|dans|pour|avec|vous|nous|cette|être)([^[:alpha:]]|$)'
REGEX_ES='[Ññ¿¡áíóúÁÍÓÚ]|(^|[^[:alpha:]])(el|los|las|una|unos|unas|que|con|para|por|pero|esto|esta|donde)([^[:alpha:]]|$)'
REGEX_EN='(^|[^[:alpha:]])(the|and|is|are|you|to|of|in|that|it|for|with|this|have|not|was)([^[:alpha:]]|$)'

# first model file inside a language directory (deterministic: sorted)
first_model_in() {
  local dir="$1"
  [ -d "$dir" ] || return 1
  find "$dir" -maxdepth 1 -type f -name '*.onnx' 2>/dev/null | LC_ALL=C sort | head -n1
}

# configured voice for a language (VOICE_<lang> in config), if it still exists
configured_voice_for() {
  local lang="$1" var="VOICE_${1}" val=""
  val="${!var:-}"
  [ -n "$val" ] && [ -f "$val" ] && printf '%s' "$val"
}

# pick the best model for a detected language: configured voice → first in dir
model_for_lang() {
  local lang="$1" m
  m="$(configured_voice_for "$lang")" && [ -n "$m" ] && { printf '%s' "$m"; return 0; }
  m="$(first_model_in "$MODELS_DIR/$lang")" && [ -n "$m" ] && { printf '%s' "$m"; return 0; }
  return 1
}

# Detection order: DE → FR → ES → EN → (undetected)
detect_lang() {
  local text="$1"
  if [[ "$text" =~ $REGEX_DE ]]; then echo de; return; fi
  if [[ "$text" =~ $REGEX_FR ]]; then echo fr; return; fi
  if [[ "$text" =~ $REGEX_ES ]]; then echo es; return; fi
  if [[ "$text" =~ $REGEX_EN ]]; then echo en; return; fi
  echo ""   # undetected
}

# Resolve the model path for a piece of text.
# Order: detected language → last-used model → English → any → error.
resolve_model() {
  local text="$1" lang m
  lang="$(detect_lang "$text")"

  if [ -n "$lang" ]; then
    m="$(model_for_lang "$lang")" && [ -n "$m" ] && { printf '%s' "$m"; return 0; }
    # detected a language we have no model for → fall through to fallbacks
  fi

  # Bug 1 fix: undetected (or unavailable) → reuse the last model actually used.
  if [ -f "$LAST_MODEL_FILE" ]; then
    m="$(cat "$LAST_MODEL_FILE" 2>/dev/null || true)"
    [ -n "$m" ] && [ -f "$m" ] && { printf '%s' "$m"; return 0; }
  fi

  # then English, then anything installed
  m="$(model_for_lang en)" && [ -n "$m" ] && { printf '%s' "$m"; return 0; }
  m="$(first_model_in "$MODELS_DIR" || true)"
  if [ -z "$m" ]; then
    # search one level deep (lang subdirs)
    m="$(find "$MODELS_DIR" -type f -name '*.onnx' 2>/dev/null | LC_ALL=C sort | head -n1 || true)"
  fi
  [ -n "$m" ] && { printf '%s' "$m"; return 0; }
  return 1
}

remember_model() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" > "$LAST_MODEL_FILE" 2>/dev/null || true
}

# sample rate from the model's json sidecar, else default
rate_for_model() {
  local json="${1}.json" r
  if [ -f "$json" ]; then
    r="$(grep -o '"sample_rate"[[:space:]]*:[[:space:]]*[0-9]\+' "$json" 2>/dev/null | grep -o '[0-9]\+' | head -n1 || true)"
    [ -n "$r" ] && { printf '%s' "$r"; return; }
  fi
  printf '%s' "$DEFAULT_RATE"
}

# ==============================================================================
# TEXT CHUNKING (sentence-level, with long-sentence splitting)
# ==============================================================================
# Produces one chunk per line. Newlines within the source are collapsed so a
# chunk never spans lines (keeps the chunk file trivially indexable).
chunk_text() {
  # stdin -> stdout (one chunk per line)
  tr '\n\r\t' '   ' \
    | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//' \
    | sed -E 's/([.!?…]+)([[:space:]]|$)/\1\n/g' \
    | sed -E 's/([;:])[[:space:]]/\1\n/g' \
    | awk 'NF' \
    | awk -v max=240 '
      {
        line=$0
        while (length(line) > max) {
          cut=max
          while (cut > 1 && substr(line, cut, 1) != " ") cut--
          if (cut <= 1) cut=max
          chunk=substr(line, 1, cut)
          sub(/ +$/, "", chunk)
          if (length(chunk)>0) print chunk
          line=substr(line, cut+1)
          sub(/^ +/, "", line)
        }
        if (length(line)>0) print line
      }'
}

# ==============================================================================
# SMART PLAYER
# ==============================================================================
# speak(): prepare state and launch the detached daemon so the keybind returns.
# The daemon plays chunk-by-chunk and listens on a FIFO for control commands.
# Playback granularity is a *sentence* (the reliable unit for the piper-tts-bin
# engine, which exposes no word-level timing). "back/forward" therefore moves by
# sentence; speed changes re-synthesize the current sentence for instant effect.
# ------------------------------------------------------------------------------
FIFO="" ; PIDFILE="" ; INDEXFILE="" ; SPEEDFILE="" ; STATUSFILE="" ; CHUNKFILE=""
_set_run_paths() {
  FIFO="$RUN_DIR/ctl.fifo"
  PIDFILE="$RUN_DIR/daemon.pid"
  INDEXFILE="$RUN_DIR/index"
  SPEEDFILE="$RUN_DIR/speed"
  STATUSFILE="$RUN_DIR/status"
  CHUNKFILE="$RUN_DIR/chunks"
}

daemon_alive() {
  [ -f "$PIDFILE" ] || return 1
  local p; p="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

kill_existing_daemon() {
  if daemon_alive; then
    local p; p="$(cat "$PIDFILE" 2>/dev/null || true)"
    kill -TERM "$p" 2>/dev/null || true
    # give it a moment to clean up its playback children
    local i=0
    while kill -0 "$p" 2>/dev/null && [ "$i" -lt 20 ]; do
      sleep 0.05; i=$((i+1))
    done
    kill -KILL "$p" 2>/dev/null || true
  fi
  pkill -f "$RUN_DIR/chunks" 2>/dev/null || true
}

cmd_speak() {
  load_config
  _set_run_paths

  local text
  have wl-paste || die "wl-clipboard is not installed (need wl-paste)"
  text="$(wl-paste --primary 2>/dev/null || true)"
  # trim; bail silently on empty selection
  [ -n "${text//[[:space:]]/}" ] || exit 0

  have "$PIPER_BIN" || die "$PIPER_BIN not found (install piper-tts-bin)"
  have aplay        || die "aplay not found (install alsa-utils)"

  local model
  model="$(resolve_model "$text")" || die "no voice model installed — run 'hyprland-tts gui' or 'hyprland-tts model install <key>'"
  remember_model "$model"

  # Fresh run dir
  kill_existing_daemon
  rm -rf "$RUN_DIR"
  mkdir -p "$RUN_DIR"

  printf '%s' "$text" | chunk_text > "$CHUNKFILE"
  [ -s "$CHUNKFILE" ] || exit 0
  printf '%s\n' "$model" > "$RUN_DIR/model"
  printf '%s\n' "${DEFAULT_SPEED}" > "$SPEEDFILE"
  printf '0\n' > "$INDEXFILE"
  rate_for_model "$model" > "$RUN_DIR/rate"

  # Launch the daemon detached from this (keybind) invocation.
  setsid -f "$0" __daemon >/dev/null 2>&1 < /dev/null || \
    ( "$0" __daemon >/dev/null 2>&1 < /dev/null & )
}

# ---- daemon internals --------------------------------------------------------
PLAY_PID=""

_daemon_start_play() {
  local text="$1"
  ( printf '%s' "$text" \
      | "$PIPER_BIN" --model "$DMODEL" --length_scale "$DSPEED" --output_raw 2>/dev/null \
      | aplay -q -r "$DRATE" -c 1 -f S16_LE -t raw 2>/dev/null ) &
  PLAY_PID=$!
}

_daemon_stop_play() {
  [ -n "$PLAY_PID" ] || return 0
  pkill -TERM -P "$PLAY_PID" 2>/dev/null || true
  kill -TERM "$PLAY_PID" 2>/dev/null || true
  wait "$PLAY_PID" 2>/dev/null || true
  PLAY_PID=""
}

_daemon_write_status() {
  printf 'index=%s total=%s speed=%s paused=%s\n' \
    "$DINDEX" "$DTOTAL" "$DSPEED" "$DPAUSED" > "$STATUSFILE" 2>/dev/null || true
  printf '%s\n' "$DINDEX" > "$INDEXFILE" 2>/dev/null || true
  printf '%s\n' "$DSPEED" > "$SPEEDFILE" 2>/dev/null || true
}

_speed_adjust() {
  # $1 = up|down (down = faster = smaller length_scale)
  local dir="$1"
  DSPEED="$(awk -v s="$DSPEED" -v st="$SPEED_STEP" -v lo="$SPEED_MIN" -v hi="$SPEED_MAX" -v d="$dir" \
    'BEGIN{ v = (d=="down") ? s-st : s+st; if (v<lo) v=lo; if (v>hi) v=hi; printf "%.1f", v }')"
}

run_daemon() {
  load_config
  _set_run_paths
  trap '_daemon_stop_play; rm -f "$PIDFILE" "$FIFO"; exit 0' TERM INT EXIT

  echo $$ > "$PIDFILE"
  [ -p "$FIFO" ] || mkfifo "$FIFO"
  exec 3<> "$FIFO"    # keep a persistent reader+writer end open

  mapfile -t CHUNKS < "$CHUNKFILE"
  DTOTAL="${#CHUNKS[@]}"
  [ "$DTOTAL" -gt 0 ] || exit 0

  DMODEL="$(cat "$RUN_DIR/model" 2>/dev/null || true)"
  DRATE="$(cat "$RUN_DIR/rate" 2>/dev/null || echo "$DEFAULT_RATE")"
  DSPEED="$(cat "$SPEEDFILE" 2>/dev/null || echo "$DEFAULT_SPEED")"
  DINDEX="$(cat "$INDEXFILE" 2>/dev/null || echo 0)"
  DPAUSED=0

  _daemon_write_status
  _daemon_start_play "${CHUNKS[$DINDEX]}"

  local cmd action
  while true; do
    if ! kill -0 "$PLAY_PID" 2>/dev/null; then
      # current chunk finished naturally → advance
      PLAY_PID=""
      DINDEX=$((DINDEX + 1))
      if [ "$DINDEX" -ge "$DTOTAL" ]; then break; fi
      _daemon_write_status
      _daemon_start_play "${CHUNKS[$DINDEX]}"
      continue
    fi

    if read -t 0.2 -u 3 cmd; then
      action="restart_needed"
      case "$cmd" in
        next)
          _daemon_stop_play
          DINDEX=$((DINDEX + 1))
          [ "$DINDEX" -ge "$DTOTAL" ] && break
          ;;
        prev)
          _daemon_stop_play
          DINDEX=$((DINDEX - 1)); [ "$DINDEX" -lt 0 ] && DINDEX=0
          ;;
        restart)
          _daemon_stop_play
          ;;
        faster)
          _speed_adjust down; _daemon_stop_play
          ;;
        slower)
          _speed_adjust up; _daemon_stop_play
          ;;
        pause)
          [ -n "$PLAY_PID" ] && pkill -STOP -P "$PLAY_PID" 2>/dev/null || true
          DPAUSED=1; action="none"
          ;;
        resume)
          [ -n "$PLAY_PID" ] && pkill -CONT -P "$PLAY_PID" 2>/dev/null || true
          DPAUSED=0; action="none"
          ;;
        toggle)
          if [ "$DPAUSED" -eq 1 ]; then
            [ -n "$PLAY_PID" ] && pkill -CONT -P "$PLAY_PID" 2>/dev/null || true
            DPAUSED=0
          else
            [ -n "$PLAY_PID" ] && pkill -STOP -P "$PLAY_PID" 2>/dev/null || true
            DPAUSED=1
          fi
          action="none"
          ;;
        stop)
          break
          ;;
        *)
          action="none"
          ;;
      esac
      if [ "$action" = "restart_needed" ]; then
        DPAUSED=0
        _daemon_write_status
        _daemon_start_play "${CHUNKS[$DINDEX]}"
      else
        _daemon_write_status
      fi
    fi
  done
}

cmd_ctl() {
  _set_run_paths
  local sub="${1:-status}"
  if [ "$sub" = "status" ]; then
    if daemon_alive && [ -f "$STATUSFILE" ]; then cat "$STATUSFILE"; else echo "idle"; fi
    return 0
  fi
  daemon_alive || exit 0   # nothing playing → no-op
  case "$sub" in
    next|prev|restart|faster|slower|pause|resume|toggle|stop)
      printf '%s\n' "$sub" > "$FIFO" 2>/dev/null || true
      ;;
    *) die "unknown control command: $sub" ;;
  esac
}

cmd_stop() {
  _set_run_paths
  if daemon_alive; then printf 'stop\n' > "$FIFO" 2>/dev/null || true; fi
  # safety net: stop any of our leftover playback
  pkill -f "$RUN_DIR/chunks" 2>/dev/null || true
}

# ==============================================================================
# MODEL MANAGEMENT
# ==============================================================================
sanitize_lang() {
  # only allow 2-3 lowercase letters — blocks path traversal
  local l="$1"
  [[ "$l" =~ ^[a-z]{2,3}$ ]] || die "invalid language code: '$l' (expected 2-3 lowercase letters)"
  printf '%s' "$l"
}

validate_url() {
  local u="$1"
  [[ "$u" =~ ^https://[A-Za-z0-9._~:/?#@!$\&\'\(\)\*\+,\;=%-]+$ ]] || die "refusing non-https or malformed URL: $u"
}

# download with a temp file, atomic move, cleanup on failure
fetch_file() {
  local url="$1" dest="$2" tmp
  tmp="$(mktemp "${dest}.XXXXXX")" || die "cannot create temp file"
  if curl -fL --retry 2 --connect-timeout 20 -o "$tmp" "$url"; then
    mv -f "$tmp" "$dest"
  else
    rm -f "$tmp"
    die "download failed: $url"
  fi
}

model_do_install() {
  # $1 lang  $2 model  $3 base_url  (downloads <base>/<model>.onnx + .onnx.json)
  local lang model base dir onnx json
  lang="$(sanitize_lang "$1")"; model="$2"; base="$3"
  # model name must be a bare filename ending safely (no traversal)
  [[ "$model" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid model name: $model"
  validate_url "$base/$model.onnx"
  validate_url "$base/$model.onnx.json"
  dir="$MODELS_DIR/$lang"
  mkdir -p "$dir"
  onnx="$dir/$model.onnx"; json="$dir/$model.onnx.json"
  log "Downloading $model → $dir"
  fetch_file "$base/$model.onnx"      "$onnx"
  fetch_file "$base/$model.onnx.json" "$json"
  # sanity: the model file must be non-trivial
  if [ ! -s "$onnx" ]; then rm -f "$onnx" "$json"; die "downloaded model is empty"; fi
  log "Installed: $lang/$model"
}

cmd_model() {
  load_config
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      local porcelain=0; [ "${1:-}" = "--porcelain" ] && porcelain=1
      local last=""; [ -f "$LAST_MODEL_FILE" ] && last="$(cat "$LAST_MODEL_FILE" 2>/dev/null || true)"
      [ -d "$MODELS_DIR" ] || { [ "$porcelain" -eq 1 ] || echo "No models installed."; return 0; }
      local found=0 f lang name size isdef islast defvar
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        found=1
        lang="$(basename "$(dirname "$f")")"
        name="$(basename "$f" .onnx)"
        size="$(stat -c%s "$f" 2>/dev/null || echo 0)"
        defvar="VOICE_${lang}"; isdef=0
        [ "${!defvar:-}" = "$f" ] && isdef=1
        islast=0; [ "$f" = "$last" ] && islast=1
        if [ "$porcelain" -eq 1 ]; then
          printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$lang/$name" "$lang" "$name" "$size" "$isdef" "$islast"
        else
          local marks=""
          [ "$isdef" -eq 1 ] && marks="$marks [default]"
          [ "$islast" -eq 1 ] && marks="$marks [last used]"
          printf '  %-8s %-28s %6s MB%s\n' "$lang" "$name" \
            "$(awk -v b="$size" 'BEGIN{printf "%.1f", b/1048576}')" "$marks"
        fi
      done < <(find "$MODELS_DIR" -type f -name '*.onnx' 2>/dev/null | LC_ALL=C sort)
      [ "$found" -eq 1 ] || [ "$porcelain" -eq 1 ] || echo "No models installed."
      ;;
    catalog)
      if [ "${1:-}" = "--porcelain" ]; then
        catalog_lines | while IFS='|' read -r key lang model base quality label; do
          local installed=0
          [ -f "$MODELS_DIR/$lang/$model.onnx" ] && installed=1
          printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$key" "$lang" "$model" "$quality" "$installed" "$label"
        done
      else
        echo "Available voices (key — description):"
        catalog_lines | while IFS='|' read -r key lang model base quality label; do
          local mark=""; [ -f "$MODELS_DIR/$lang/$model.onnx" ] && mark="  ✓ installed"
          printf '  %-20s %s%s\n' "$key" "$label" "$mark"
        done
      fi
      ;;
    install)
      local key="${1:-}"; [ -n "$key" ] || die "usage: hyprland-tts model install <key>  (see 'model catalog')"
      local line; line="$(catalog_lines | awk -F'|' -v k="$key" '$1==k{print; exit}')"
      [ -n "$line" ] || die "unknown catalog key: $key  (see 'model catalog')"
      IFS='|' read -r _ lang model base _ _ <<< "$line"
      model_do_install "$lang" "$model" "$base"
      ;;
    install-url)
      # hyprland-tts model install-url <lang> <onnx-url> [json-url]
      local lang="${1:-}" onnx_url="${2:-}" json_url="${3:-}"
      [ -n "$lang" ] && [ -n "$onnx_url" ] || die "usage: hyprland-tts model install-url <lang> <onnx-url> [json-url]"
      lang="$(sanitize_lang "$lang")"
      validate_url "$onnx_url"
      [[ "$onnx_url" =~ \.onnx$ ]] || die "onnx URL must end in .onnx"
      [ -n "$json_url" ] || json_url="${onnx_url}.json"
      validate_url "$json_url"
      [[ "$json_url" =~ \.onnx\.json$ ]] || die "json URL must end in .onnx.json"
      local model base
      model="$(basename "$onnx_url" .onnx)"
      base="$(dirname "$onnx_url")"
      # reconstruct: model_do_install expects base without filename
      model_do_install "$lang" "$model" "$base"
      # if the sidecar name differs from <model>.onnx.json, fetch explicitly
      if [ ! -s "$MODELS_DIR/$lang/$model.onnx.json" ]; then
        fetch_file "$json_url" "$MODELS_DIR/$lang/$model.onnx.json"
      fi
      ;;
    remove)
      local id="${1:-}"; [ -n "$id" ] || die "usage: hyprland-tts model remove <lang/name>"
      [[ "$id" == */* ]] || die "id must be <lang>/<name>"
      local lang name f
      lang="${id%%/*}"; name="${id#*/}"
      lang="$(sanitize_lang "$lang")"
      [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid model name: $name"
      f="$MODELS_DIR/$lang/$name.onnx"
      [ -f "$f" ] || die "no such model: $id"
      rm -f "$f" "${f}.json"
      log "Removed: $id"
      # if it was the default or last-used, clear those references
      local defvar="VOICE_${lang}"
      [ "${!defvar:-}" = "$f" ] && unset_config_var "$defvar"
      [ -f "$LAST_MODEL_FILE" ] && [ "$(cat "$LAST_MODEL_FILE" 2>/dev/null)" = "$f" ] && rm -f "$LAST_MODEL_FILE"
      # remove now-empty language dir
      rmdir "$MODELS_DIR/$lang" 2>/dev/null || true
      ;;
    default)
      local id="${1:-}"; [ -n "$id" ] || die "usage: hyprland-tts model default <lang/name>"
      [[ "$id" == */* ]] || die "id must be <lang>/<name>"
      local lang name f
      lang="${id%%/*}"; name="${id#*/}"
      lang="$(sanitize_lang "$lang")"
      f="$MODELS_DIR/$lang/$name.onnx"
      [ -f "$f" ] || die "no such model: $id"
      set_config_var "VOICE_${lang}" "$f"
      log "Default voice for '$lang' set to $name"
      ;;
    *) die "unknown model subcommand: $sub" ;;
  esac
}

# ------------------------------------------------------------------------------
# config file read/write (idempotent, whole-file rewrite of known keys)
# ------------------------------------------------------------------------------
set_config_var() {
  local key="$1" val="$2"
  mkdir -p "$CONFIG_DIR"
  touch "$CONFIG_FILE"
  # strip any existing definition, then append the new one
  grep -v -E "^${key}=" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null || true
  printf '%s=%q\n' "$key" "$val" >> "${CONFIG_FILE}.tmp"
  mv -f "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
}

unset_config_var() {
  local key="$1"
  [ -f "$CONFIG_FILE" ] || return 0
  grep -v -E "^${key}=" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null || true
  mv -f "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
}

# ==============================================================================
# GUI LAUNCHER
# ==============================================================================
cmd_gui() {
  if have hyprland-tts-gui; then
    exec hyprland-tts-gui "$@"
  fi
  # allow running from a source checkout
  local here; here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  if [ -x "$here/../gui/hyprland-tts-gui" ]; then
    exec "$here/../gui/hyprland-tts-gui" "$@"
  fi
  die "GUI not found. Install the optional dependencies (gtk4, libadwaita, python-gobject) and the hyprland-tts-gui component."
}

# ==============================================================================
# SETUP / UNINSTALL (per-user Hyprland wiring — idempotent)
# ==============================================================================
SOURCE_LINE="source = ~/.config/hypr/tts.conf"
SOURCE_MARK="# hyprland-tts (Text-to-Speech) module"

write_tts_conf() {
  mkdir -p "$HYPR_DIR"
  cat > "$TTS_CONF" <<'CONF'
# ==============================================================================
# hyprland-tts — Text-to-Speech keybinds (managed module; safe to edit)
# ==============================================================================
# Core
bind = SUPER, A, exec, hyprland-tts speak            # speak current selection
bind = SUPER, ESCAPE, exec, hyprland-tts stop        # stop speech

# Smart playback controls
bind = SUPER ALT, right, exec, hyprland-tts ctl next     # next sentence
bind = SUPER ALT, left,  exec, hyprland-tts ctl prev     # previous sentence
bind = SUPER ALT, down,  exec, hyprland-tts ctl slower   # slow down
bind = SUPER ALT, up,    exec, hyprland-tts ctl faster   # speed up
bind = SUPER ALT, space, exec, hyprland-tts ctl toggle   # pause / resume
bind = SUPER ALT, R,     exec, hyprland-tts ctl restart  # replay current sentence
CONF
}

cmd_setup() {
  write_tts_conf
  if [ -f "$MAIN_CONF" ]; then
    if grep -qE '^[[:space:]]*source[[:space:]]*=.*tts\.conf[[:space:]]*$' "$MAIN_CONF"; then
      log "hyprland.conf already sources tts.conf — left untouched."
    else
      { printf '\n%s\n%s\n' "$SOURCE_MARK" "$SOURCE_LINE"; } >> "$MAIN_CONF"
      log "Linked tts.conf into hyprland.conf."
    fi
  else
    log "warning: no hyprland.conf found; wrote $TTS_CONF standalone. Add: $SOURCE_LINE"
  fi
  have hyprctl && hyprctl reload >/dev/null 2>&1 || true
  cat >&2 <<EOF

hyprland-tts setup complete.
  Speak selection : SUPER + A
  Stop            : SUPER + ESCAPE
  Next / Prev     : SUPER + ALT + Right / Left
  Faster / Slower : SUPER + ALT + Up / Down
  Pause / Resume  : SUPER + ALT + Space
  Manage voices   : hyprland-tts gui   (or: hyprland-tts model ...)
EOF
  # first-run hint if no models
  if ! find "$MODELS_DIR" -type f -name '*.onnx' >/dev/null 2>&1 || \
     [ -z "$(find "$MODELS_DIR" -type f -name '*.onnx' 2>/dev/null | head -n1)" ]; then
    log ""
    log "No voice models yet. Install one, e.g.:  hyprland-tts model install en-ryan-high"
  fi
}

remove_source_link() {
  [ -f "$MAIN_CONF" ] || return 0
  # Remove our marker line via fixed-string match (it contains '#', '(', ')',
  # so no regex delimiter is safe). rc<=1 covers "some/all lines filtered".
  local tmp="${MAIN_CONF}.ttstmp" rc=0
  grep -vF "$SOURCE_MARK" "$MAIN_CONF" > "$tmp" 2>/dev/null || rc=$?
  if [ "$rc" -le 1 ]; then mv -f "$tmp" "$MAIN_CONF"; else rm -f "$tmp"; fi
  # Remove any tts.conf source line ('#' delimiter avoids the '|' that ERE would
  # otherwise read as the address delimiter; paths never contain '#').
  sed -i -E '\#^[[:space:]]*source[[:space:]]*=.*tts\.conf[[:space:]]*$#d' "$MAIN_CONF" 2>/dev/null || true
}

cmd_uninstall() {
  cmd_stop 2>/dev/null || true
  [ -f "$TTS_CONF" ] && rm -f "$TTS_CONF" && log "Removed $TTS_CONF"
  remove_source_link
  log "Removed tts.conf source link from hyprland.conf (if present)."
  have hyprctl && hyprctl reload >/dev/null 2>&1 || true
  log "Downloaded voice models kept at $MODELS_DIR (use 'hyprland-tts purge' to remove them)."
}

cmd_purge() {
  cmd_uninstall
  [ -d "$MODELS_DIR" ] && rm -rf "$MODELS_DIR" && log "Removed models: $MODELS_DIR"
  [ -d "$STATE_DIR" ]  && rm -rf "$STATE_DIR"  && log "Removed state: $STATE_DIR"
  [ -d "$CONFIG_DIR" ] && rm -rf "$CONFIG_DIR" && log "Removed config: $CONFIG_DIR"
}

# ==============================================================================
# HELP + DISPATCH
# ==============================================================================
usage() {
  cat <<'EOF'
hyprland-tts — accessible, multilingual, offline TTS for Hyprland

USAGE
  hyprland-tts speak                 Speak the current primary selection
  hyprland-tts stop                  Stop playback
  hyprland-tts ctl <cmd>             next|prev|restart|faster|slower|
                                     pause|resume|toggle|stop|status
  hyprland-tts model list            List installed voice models
  hyprland-tts model catalog         List curated downloadable voices
  hyprland-tts model install <key>   Install a curated voice
  hyprland-tts model install-url <lang> <onnx-url> [json-url]
  hyprland-tts model remove <lang/name>
  hyprland-tts model default <lang/name>
  hyprland-tts gui                   Launch the graphical model manager
  hyprland-tts setup                 Wire keybinds into Hyprland
  hyprland-tts uninstall             Remove keybinds (keep models)
  hyprland-tts purge                 Remove keybinds AND models/state/config
  hyprland-tts help                  Show this help
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    speak)      cmd_speak "$@" ;;
    __daemon)   run_daemon ;;      # internal: the playback daemon
    ctl)        cmd_ctl "$@" ;;
    stop)       cmd_stop ;;
    model)      cmd_model "$@" ;;
    gui)        cmd_gui "$@" ;;
    setup)      cmd_setup ;;
    uninstall)  cmd_uninstall ;;
    purge)      cmd_purge ;;
    -h|--help|help) usage ;;
    *) log "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
