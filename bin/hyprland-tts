#!/usr/bin/env bash
# ==============================================================================
# hyprland-tts — accessible, multilingual, offline Text-to-Speech for Hyprland
# ------------------------------------------------------------------------------
# Thin dispatcher. All logic lives in the lib/ modules (single source of truth);
# the GUI and installers are thin skins over these subcommands. See Agent.md.
# ==============================================================================
set -euo pipefail

# --- locate the library directory (works installed or from a git checkout) ----
_self="$(readlink -f "${BASH_SOURCE[0]}")"
_selfdir="$(dirname "$_self")"
LIBDIR=""
for _cand in \
  "${HYPRLAND_TTS_LIB:-}" \
  "$_selfdir/../lib/hyprland-tts" \
  "$_selfdir/../lib" \
  "/usr/lib/hyprland-tts" \
  "$HOME/.local/lib/hyprland-tts"; do
  if [ -n "$_cand" ] && [ -f "$_cand/common.sh" ]; then LIBDIR="$_cand"; break; fi
done
[ -n "$LIBDIR" ] || { echo "hyprland-tts: cannot locate library directory" >&2; exit 1; }

# Modules call back into this script (setsid ... __daemon/__worker), so they need its path.
export HTTS_SELF="$_self"
# shellcheck source=/dev/null
source "$LIBDIR/common.sh"
# Module order matters only for readability: every module defines functions, nothing runs.
for _m in text router model image keybind engine qwen3 qwen3_install worker voices player \
  setup hover; do
  # shellcheck source=/dev/null
  source "$LIBDIR/$_m.sh"
done
# pyenv.sh (language-ID helper environment) is optional so older installs keep working.
# shellcheck source=/dev/null
[ -f "$LIBDIR/pyenv.sh" ] && source "$LIBDIR/pyenv.sh"

# --- GUI launcher -------------------------------------------------------------
# Find a python3 that actually has the GTK bindings. A bare `python3` lookup
# trusts $PATH, which on many desktops is shadowed by a user-managed interpreter
# (pyenv/mise/conda/uv/asdf) that has no idea gtk4/libadwaita exist — that
# interpreter is what pacman-installed PyGObject is NOT installed into. This bit
# a real user: `hyprland-tts gui` reported the stack missing while
# `pacman -S gtk4 libadwaita python-gobject` said "up to date". Root cause: PATH.
# Fix: probe PATH's python3 first, then fall back to the system interpreter by
# absolute path (sudo's sanitized PATH happens to hit this one, which is why it
# "worked" under sudo — that is a red herring, NOT a real fix; see the root guard
# in main(), running the GUI as root breaks Wayland/GTK entirely).
_gui_python() {
  local cand
  for cand in python3 /usr/bin/python3; do
    have "$cand" || continue
    if "$cand" -c 'import gi; gi.require_version("Gtk","4.0"); gi.require_version("Adw","1")' \
         >/dev/null 2>&1; then
      printf '%s' "$cand"; return 0
    fi
  done
  return 1
}

cmd_gui() {
  local gui=""
  if gui="$(command -v hyprland-tts-gui 2>/dev/null)"; then :
  elif [ -x "$_selfdir/../gui/hyprland-tts-gui" ]; then gui="$_selfdir/../gui/hyprland-tts-gui"
  else die "GUI component not found."
  fi

  local py
  py="$(_gui_python)" || die "GUI needs GTK4 + libadwaita + PyGObject for python3. Install them:\n  sudo pacman -S --needed gtk4 libadwaita python-gobject\n\nIf they're already installed and this still fails, another 'python3' earlier in\nyour PATH (pyenv/mise/conda/uv/asdf) is shadowing the system interpreter that\nthose packages install into. Verify with:\n  which python3\n  /usr/bin/python3 -c 'import gi'"
  # invoke python3 explicitly on the script path (bypasses its #!/usr/bin/env
  # shebang, so this always runs with the interpreter we just validated)
  exec "$py" "$gui" "$@"
}

# usage — print the command overview.
# Args:    none
# Returns: 0 always; stdout: help text
# Globals: none
usage() {
  cat <<'EOF'
hyprland-tts — accessible, multilingual, offline TTS for Hyprland

USAGE
  hyprland-tts speak                 Speak selection (or a clipboard image)
  hyprland-tts hover                 Speak text under the mouse cursor (AT-SPI, best-effort)
  hyprland-tts stop                  Stop playback (the warm engine worker keeps running)
  hyprland-tts ctl <cmd>             next|prev|restart|faster|slower|
                                     pause|resume|toggle|stop|status
  hyprland-tts engine <sub>          status|install qwen3 [--cpu|--vulkan]
                                     [--variant base|customvoice]|remove qwen3|
                                     use auto|qwen3|piper|start|stop
  hyprland-tts voice <sub>           list|add <name> <wav> <transcript>|remove <name>|
                                     set <lang> <voice>
  hyprland-tts model <sub>           list|catalog|install|install-url|remove|default|fallback
  hyprland-tts keybind <sub>         list|set|check|reset  (rebind shortcuts safely)
  hyprland-tts gui                   Graphical voice + shortcut manager
  hyprland-tts setup                 Wire keybinds into Hyprland
  hyprland-tts uninstall             Remove keybinds (keep models)
  hyprland-tts purge                 Remove keybinds AND models/state/config
  hyprland-tts help                  Show this help
EOF
}

refuse_root() {
  [ "${HYPRLAND_TTS_ALLOW_ROOT:-}" = "1" ] && return 0
  [ "$(id -u)" -ne 0 ] || die "Do not run hyprland-tts as root or with sudo.\nIt manages files under your own \$HOME (~/.config, ~/.local) and talks to your\nWayland session — both are wrong or unreachable as root. Run it as your normal\ndesktop user:\n  hyprland-tts $*"
}

# command_deps — run the optional language-ID environment manager when it is installed.
# Args:    $1.. <deps subcommand arguments>
# Returns: the subcommand's status; exits 1 when pyenv.sh is not available
# Globals: none
command_deps() {
  # cmd_deps comes from the optional pyenv.sh module; absent means a pre-2.0 library set.
  declare -F cmd_deps >/dev/null || die "'deps' is not available in this installation"
  cmd_deps "$@"
}

# main — dispatch the subcommand named by the first argument.
# Args:    $1 <subcommand>; $2.. <its arguments>
# Returns: 0 on success; 1 for an unknown command
# Globals: none
main() {
  refuse_root "$@"
  local cmd="${1:-help}"; shift || true
  # One line per command; the work lives in the cmd_* / command_* functions.
  case "$cmd" in
    speak)      cmd_speak "$@" ;; # read the selection aloud
    hover)      cmd_hover "$@" ;; # read the text under the cursor
    __daemon)   run_daemon ;; # internal: the detached player
    __worker)   run_worker ;; # internal: the detached warm-engine worker
    ctl)        cmd_ctl "$@" ;; # playback controls via mpv IPC
    stop)       cmd_stop ;; # stop playback only
    engine)     cmd_engine "$@" ;; # engine install/selection/worker
    voice)      cmd_voice "$@" ;; # voice choice and cloning
    deps)       command_deps "$@" ;; # optional language-ID environment
    model)      cmd_model "$@" ;; # Piper voice manager
    keybind)    cmd_keybind "$@" ;; # shortcut manager
    gui)        cmd_gui "$@" ;; # graphical manager
    setup)      cmd_setup ;; # wire keybinds into Hyprland
    uninstall)  cmd_uninstall ;; # remove keybind wiring
    purge)      cmd_purge ;; # remove wiring and user data
    -h|--help|help) usage ;;
    *) log "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
